# GitHub fine-grained personal access token.
# Resource owner: the account below. Repository access: "All repositories".
# Repository permissions: Administration: read-only (traffic) + Metadata: read-only (default).
GITHUB_TOKEN=
# User or organisation whose public repos are monitored
GITHUB_OWNER=

# Login: Basic authentication is enabled by default and requires BOTH credentials.
# Choose a unique password. Use single quotes if it contains '$' or '#'.
DASHBOARD_AUTH=basic
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Already using an authenticating reverse proxy? Set DASHBOARD_AUTH=external instead.
# This disables authentication inside RepoWatch; protect every path, including /api/.
# TeleLogin is optional, not a dependency.

# Docker Compose: listen locally by default. Use a reverse proxy with HTTPS for remote access.
# REPOWATCH_BIND=127.0.0.1
# REPOWATCH_PORT=8765
# Collect immediately on startup, then every six hours (seconds, minimum 60).
# COLLECT_INTERVAL_SECONDS=21600

# Optional
# Since July 2026 GitHub limits the stargazers list (who starred, and when) to admins and
# collaborators, i.e. tokens with write access (fine-grained: Contents read & write;
# classic: public_repo). Without it new stars are still detected from the daily count, just
# without names. Only set this if you accept giving a write-capable token to RepoWatch.
# GITHUB_STARS_TOKEN=github_pat_xxx
# REPOWATCH_DB=data/repowatch.db
# Backups (`repowatch backup`): keep all copies of the last N days, then one per week/month
# REPOWATCH_BACKUP_DIR=data/backups
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# INCLUDE_FORKS=false
# INCLUDE_ARCHIVED=true
# EXCLUDE_REPOS=repo-a,repo-b
# Repos published on PyPI: "repo:package" pairs, or just "repo" when names match
# PYPI_PACKAGES=my-repo:my-package
# Fetch the jobs of each CI run to count actions/checkout clones (1 extra request per run)
# CI_JOBS=true
# A "spike" event fires when daily unique visitors > SPIKE_FACTOR x the previous 14-day average
# SPIKE_FACTOR=3
# SPIKE_MIN_UNIQUES=5
